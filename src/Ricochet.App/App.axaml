<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="Ricochet.App.App">
  <!-- No RequestedThemeVariant: the app follows the operating system's light or dark setting (ADR 0013). -->
  <Application.Resources>
    <ResourceDictionary>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

    <!-- Icons, drawn on a 24 by 24 grid -->
    <StreamGeometry x:Key="IconPlus">M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4z</StreamGeometry>
    <StreamGeometry x:Key="IconImport">M11 4h2v9.2l3.3-3.3 1.4 1.4L12 17l-5.7-5.7 1.4-1.4 3.3 3.3V4zM5 18h14v2H5z</StreamGeometry>
    <StreamGeometry x:Key="IconSliders">M4 6h9V4h2v2h5v2h-5v2h-2V8H4zM4 16h5v-2h2v2h9v2h-9v2H9v-2H4z</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6z</StreamGeometry>

    <!-- Every colour is defined once per theme, so views only refer to names (ADR 0013) -->
    <ResourceDictionary.ThemeDictionaries>
      <!-- Dark: panels float on a darker background, and borders stay barely visible -->
      <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="AppBackground" Color="#0D0E12" />
        <SolidColorBrush x:Key="SurfaceBackground" Color="#15171C" />
        <SolidColorBrush x:Key="RaisedBackground" Color="#23262E" />
        <SolidColorBrush x:Key="HoverBackground" Color="#1D2026" />
        <SolidColorBrush x:Key="Hairline" Color="#22252C" />
        <SolidColorBrush x:Key="StrongLine" Color="#30343D" />
        <SolidColorBrush x:Key="TextPrimary" Color="#ECEEF2" />
        <SolidColorBrush x:Key="TextMuted" Color="#8B909B" />
        <SolidColorBrush x:Key="Accent" Color="#FF7A50" />
        <SolidColorBrush x:Key="AccentHover" Color="#FF9070" />
        <SolidColorBrush x:Key="OnAccent" Color="#1A0F0A" />
        <SolidColorBrush x:Key="Success" Color="#4ADE80" />
        <SolidColorBrush x:Key="SuccessBackground" Color="#12291D" />
        <SolidColorBrush x:Key="Failure" Color="#F87171" />
        <SolidColorBrush x:Key="FailureBackground" Color="#321A1D" />
        <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
        <SolidColorBrush x:Key="WarningBackground" Color="#2A2210" />
        <SolidColorBrush x:Key="WarningBorder" Color="#4A3C15" />
        <SolidColorBrush x:Key="FailureBorder" Color="#5A2A2E" />
        <SolidColorBrush x:Key="Info" Color="#60A5FA" />
        <SolidColorBrush x:Key="InfoBackground" Color="#14233A" />
        <SolidColorBrush x:Key="InfoBorder" Color="#21395E" />
        <SolidColorBrush x:Key="SecretOnBackground" Color="#33211A" />
        <SolidColorBrush x:Key="UrlBarBackground" Color="#1D2026" />
        <SolidColorBrush x:Key="Scrim" Color="#B3050608" />
        <SolidColorBrush x:Key="LineNumbers" Color="#808795" />
        <SolidColorBrush x:Key="JsonProperty" Color="#7DD3FC" />
        <SolidColorBrush x:Key="JsonString" Color="#86EFAC" />
        <SolidColorBrush x:Key="JsonNumber" Color="#FDBA74" />
        <SolidColorBrush x:Key="JsonKeyword" Color="#C4B5FD" />
        <SolidColorBrush x:Key="JsonText" Color="#D4D4D8" />
        <SolidColorBrush x:Key="MethodGet" Color="#4ADE80" />
        <SolidColorBrush x:Key="MethodPost" Color="#FBBF24" />
        <SolidColorBrush x:Key="MethodPut" Color="#60A5FA" />
        <SolidColorBrush x:Key="MethodPatch" Color="#C084FC" />
        <SolidColorBrush x:Key="MethodDelete" Color="#F87171" />
        <SolidColorBrush x:Key="MethodOther" Color="#8A909C" />

        <!-- Fluent theme overrides: filled inputs with no border until focused -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#1D2026" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#23262E" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1D2026" />
        <!-- Unfocused control borders need 3:1 against the panel (WCAG 1.4.11); focus stays accent -->
        <SolidColorBrush x:Key="ControlBorder" Color="#6B717C" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#6B717C" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#6B717C" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF7A50" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A909B" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A909B" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8A909B" />
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#1D2026" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#23262E" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#6B717C" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#6B717C" />
        <SolidColorBrush x:Key="ButtonBackground" Color="#1D2026" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2A2E37" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#181A20" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#6B717C" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#6B717C" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#6B717C" />
        <!-- Text in the accent colour: the brighter Accent is only for fills and focus rings -->
        <SolidColorBrush x:Key="AccentText" Color="#FF7A50" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#23262E" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2A2E37" />
        <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#23262E" />
        <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#2A2E37" />
        <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#1D2026" />
      </ResourceDictionary>

      <!-- Light: white panels on a cool grey background, with darker text and the same accent family -->
      <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="AppBackground" Color="#F3F4F7" />
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="RaisedBackground" Color="#E8EAF0" />
        <SolidColorBrush x:Key="HoverBackground" Color="#EDEFF3" />
        <SolidColorBrush x:Key="Hairline" Color="#E3E6EC" />
        <SolidColorBrush x:Key="StrongLine" Color="#CDD2DB" />
        <SolidColorBrush x:Key="TextPrimary" Color="#15171C" />
        <SolidColorBrush x:Key="TextMuted" Color="#5D6470" />
        <SolidColorBrush x:Key="Accent" Color="#E85D31" />
        <SolidColorBrush x:Key="AccentHover" Color="#F07245" />
        <SolidColorBrush x:Key="OnAccent" Color="#1A0F0A" />
        <SolidColorBrush x:Key="Success" Color="#166534" />
        <SolidColorBrush x:Key="SuccessBackground" Color="#DDF6E6" />
        <SolidColorBrush x:Key="Failure" Color="#B42318" />
        <SolidColorBrush x:Key="FailureBackground" Color="#FDE4E1" />
        <SolidColorBrush x:Key="Warning" Color="#B45309" />
        <SolidColorBrush x:Key="WarningBackground" Color="#FEF3DC" />
        <SolidColorBrush x:Key="WarningBorder" Color="#F5D58A" />
        <SolidColorBrush x:Key="FailureBorder" Color="#F5B5AE" />
        <SolidColorBrush x:Key="Info" Color="#1D4ED8" />
        <SolidColorBrush x:Key="InfoBackground" Color="#E6EFFD" />
        <SolidColorBrush x:Key="InfoBorder" Color="#B7CCF2" />
        <SolidColorBrush x:Key="SecretOnBackground" Color="#FBE3D9" />
        <SolidColorBrush x:Key="UrlBarBackground" Color="#EEF0F4" />
        <SolidColorBrush x:Key="Scrim" Color="#8C15171C" />
        <SolidColorBrush x:Key="LineNumbers" Color="#636B78" />
        <SolidColorBrush x:Key="JsonProperty" Color="#0369A1" />
        <SolidColorBrush x:Key="JsonString" Color="#15803D" />
        <SolidColorBrush x:Key="JsonNumber" Color="#C2410C" />
        <SolidColorBrush x:Key="JsonKeyword" Color="#7C3AED" />
        <SolidColorBrush x:Key="JsonText" Color="#27272A" />
        <SolidColorBrush x:Key="MethodGet" Color="#15803D" />
        <SolidColorBrush x:Key="MethodPost" Color="#B45309" />
        <SolidColorBrush x:Key="MethodPut" Color="#1D4ED8" />
        <SolidColorBrush x:Key="MethodPatch" Color="#7E22CE" />
        <SolidColorBrush x:Key="MethodDelete" Color="#B91C1C" />
        <SolidColorBrush x:Key="MethodOther" Color="#5D6470" />

        <SolidColorBrush x:Key="TextControlBackground" Color="#EEF0F4" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#E3E6EC" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#EEF0F4" />
        <!-- Unfocused control borders need 3:1 against the panel (WCAG 1.4.11); focus stays accent -->
        <SolidColorBrush x:Key="ControlBorder" Color="#7D848F" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#7D848F" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#7D848F" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#E85D31" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#646B77" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#646B77" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#646B77" />
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#EEF0F4" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#E3E6EC" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#7D848F" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#7D848F" />
        <SolidColorBrush x:Key="ButtonBackground" Color="#EEF0F4" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E2E5EC" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D8DCE4" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#7D848F" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#7D848F" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#7D848F" />
        <!-- Text in the accent colour: the brighter Accent is only for fills and focus rings -->
        <SolidColorBrush x:Key="AccentText" Color="#A93A16" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#E8EAF0" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#DCDFE7" />
        <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#E8EAF0" />
        <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#DCDFE7" />
        <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#EEF0F4" />
      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Not colours, so the same in both themes -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FF7A50" />
        <ColorPaletteResources x:Key="Light" Accent="#E85D31" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <Style Selector="Window">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Background" Value="{DynamicResource AppBackground}" />
    </Style>

    <!-- The window's title bar: three buttons are enough -->

    <Style Selector="Button[(chrome|WindowDecorationProperties.ElementRole)=FullScreenButton]">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Panels -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="26,22" />
      <Setter Property="Margin" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Text -->
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="TextBlock.brand">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.method">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Status pill -->
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="11,3" />
      <Setter Property="Background" Value="{DynamicResource RaisedBackground}" />
    </Style>
    <Style Selector="Border.badge.success">
      <Setter Property="Background" Value="{DynamicResource SuccessBackground}" />
    </Style>
    <Style Selector="Border.badge.failure">
      <Setter Property="Background" Value="{DynamicResource FailureBackground}" />
    </Style>
    <Style Selector="Border.badge.warning">
      <Setter Property="Background" Value="{DynamicResource WarningBackground}" />
    </Style>
    <Style Selector="Border.badge.redirect">
      <Setter Property="Background" Value="{DynamicResource InfoBackground}" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.badge.success TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Success}" />
    </Style>
    <Style Selector="Border.badge.redirect TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Info}" />
    </Style>
    <Style Selector="Border.badge.warning TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Warning}" />
    </Style>
    <Style Selector="Border.badge.failure TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Failure}" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBox.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- URL bar: one filled control, with the send button sitting inside it -->
    <Style Selector="Border.urlbar">
      <Setter Property="Background" Value="{DynamicResource UrlBarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="5" />
    </Style>
    <Style Selector="Border.urlbar:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <!-- The controls inside the URL bar sit on its fill, so they draw no border of their own -->
    <Style Selector="Border.urlbar ComboBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Secret toggle: accent colour when on, so protected rows are easy to spot -->
    <Style Selector="ToggleButton.secret">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.secret:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SecretOnBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="ToggleButton.small">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ToggleButton.small:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RaisedBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- Banners: one shape for every notice. Add the variant class (info, warning or error) for its colours. -->
    <Style Selector="Border.banner">
      <Setter Property="Background" Value="{DynamicResource InfoBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InfoBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.banner.info TextBlock, Border.banner.info SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Info}" />
    </Style>
    <Style Selector="Border.banner.warning">
      <Setter Property="Background" Value="{DynamicResource WarningBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}" />
    </Style>
    <Style Selector="Border.banner.warning TextBlock, Border.banner.warning SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Warning}" />
    </Style>
    <Style Selector="Border.banner.error">
      <Setter Property="Background" Value="{DynamicResource FailureBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FailureBorder}" />
    </Style>
    <Style Selector="Border.banner.error TextBlock, Border.banner.error SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Failure}" />
    </Style>
    <Style Selector="Border.banner Button.banner-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <!-- Filled accent and text-only buttons keep no outline; only the fill or the words mark them -->
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.requesttab">
      <Setter Property="Background" Value="{DynamicResource RaisedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.requesttab.active">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.mini /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.mini:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.mini">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <!-- Folder actions (rename, new folder) are glyphs, so they need more room than the delete cross -->
    <Style Selector="Button.folderaction">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="MinWidth" Value="26" />
    </Style>
    <Style Selector="Button.mini PathIcon">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
    </Style>

    <!-- Tree delete buttons stay out of the way until the row is in use -->
    <Style Selector="TreeViewItem Button.mini">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="TreeViewItem Grid:pointerover > Button.mini">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TreeViewItem Button.mini:focus">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Rounded rows in the sidebar -->
    <Style Selector="TreeViewItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Tabs: pills instead of underlines -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource RaisedBackground}" />
    </Style>
    <Style Selector="TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource RaisedBackground}" />
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox, TreeView">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- The gaps between panels are the resize handles -->
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinWidth" Value="8" />
      <Setter Property="MinHeight" Value="8" />
    </Style>
  </Application.Styles>
</Application>
