<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ricochet.App.ViewModels"
             x:Class="Ricochet.App.Views.KeyValueEditor"
             x:DataType="vm:KeyValueListViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" Margin="0,14,10,12">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:KeyValueRowViewModel">
            <Grid ColumnDefinitions="Auto,*,10,2*,Auto,Auto">
              <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" MinWidth="32" />
              <TextBox Grid.Column="1" Classes="mono" Text="{Binding Key}" PlaceholderText="{Binding KeyPlaceholder}" />
              <TextBox Grid.Column="3" Classes="mono" Text="{Binding Value}" PasswordChar="{Binding ValueMask}"
                       PlaceholderText="{Binding ValuePlaceholder}" />
              <ToggleButton Grid.Column="4" Classes="secret" Content="Secret" Margin="8,0,0,0"
                            IsChecked="{Binding IsSecret}" IsVisible="{Binding AllowSecrets}"
                            AutomationProperties.Name="Secret"
                            ToolTip.Tip="Keep this value in your system's secure storage, out of your files" />
              <Button Grid.Column="5" Classes="mini" Margin="8,0,0,0" Command="{Binding RemoveCommand}"><PathIcon Data="{StaticResource IconClose}" /></Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Classes="ghost" Content="Add row" Command="{Binding AddCommand}" Padding="10,5" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
